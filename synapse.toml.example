# Synapse Configuration
# Copy this to ~/.synapse/config.toml and edit as needed

[synapse]
# Folders to watch and index (use forward slashes or double backslashes on Windows)
watch_paths = [
    "C:/Users/YourName/Projects/myapp",
    "C:/Users/YourName/Projects/anotherproject",
]

# File patterns to ignore (supports glob syntax)
ignore_patterns = [
    "*.pyc",
    "__pycache__",
    "node_modules",
    ".git",
    "dist",
    "build",
    ".venv",
    "venv",
    "*.egg-info",
    ".pytest_cache",
    "*.min.js",
    "*.min.css",
    "*.lock",
    "package-lock.json",
]

[embedding]
# "local"  → uses sentence-transformers (free, private, ~400MB model download on first run)
# "openai" → uses OpenAI API (requires OPENAI_API_KEY env var, better quality)
provider = "local"

# Local model (only used if provider = "local")
model = "nomic-ai/nomic-embed-text-v1.5"

# Chunk size in tokens (smaller = more precise retrieval, larger = more context per result)
chunk_size = 512

# Overlap between consecutive chunks (helps preserve context at chunk boundaries)
chunk_overlap = 64
